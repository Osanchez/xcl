#!/bin/sh
# Refuse to create a merge commit for a commit that merge-pr.py did not approve.
#
# Install once (git hooks are per clone):
#     git config core.hooksPath .githooks
#
# MERGE_HEAD names what is coming in. The merge is allowed when
#   * every MERGE_HEAD commit is already an ancestor of HEAD (nothing new comes in), or
#   * <git-common-dir>/pr-gate/<id>.approved.json exists for it, naming this HEAD. merge-pr.py
#     writes that file just before it merges, after the review and --approve checks.
# Otherwise the merge is refused. There is no exemption for remote branches: upstream code
# arrives only through merge-pr.py.
#
# Measured with git 2.53: during a plain `git merge` git runs this hook BEFORE it writes
# MERGE_HEAD, so there the hook cannot see what comes in and refuses (fail closed): a hand
# merge that makes a commit is stopped here, whatever it merges. `git commit` that concludes a
# merge runs only pre-commit, never this hook. So merge-pr.py merges with --no-commit and then
# commits, and does not depend on this hook; the approval file is what this hook would honour
# if git ever shows it MERGE_HEAD.
#
# A seatbelt, not the mechanism: it does not run for a fast-forward (merge-pr.py always passes
# --no-ff), `git merge --no-verify` skips it (merge-guard.py denies that), and `git cherry-pick`
# never reaches it. Works in linked worktrees: both paths come from `git rev-parse`.

refuse() {
    cat >&2 <<EOF

pre-merge-commit: refusing this merge: $1

Outside code (a pull request, upstream main) is merged only with
    python scripts/dev/merge-pr.py <N | --sync> --approve <full id>
after pr-gate.py scan and record-review. Undo this merge with: git merge --abort

EOF
    exit 1
}

merge_head=$(git rev-parse --git-path MERGE_HEAD) || refuse "cannot locate MERGE_HEAD"
[ -f "$merge_head" ] || refuse "git did not say what comes in (no MERGE_HEAD), so it cannot be checked"
common=$(git rev-parse --path-format=absolute --git-common-dir) || refuse "cannot locate the git dir"
here=$(git rev-parse HEAD) || refuse "cannot read HEAD"

seen=0
while IFS= read -r line || [ -n "$line" ]; do
    incoming=$(printf '%s' "$line" | tr -d ' \t\r')
    [ -n "$incoming" ] || continue
    seen=1
    case "$incoming" in
        *[!0-9a-f]*) refuse "MERGE_HEAD holds something that is not a commit id" ;;
    esac
    [ "${#incoming}" -eq 40 ] || refuse "MERGE_HEAD holds something that is not a commit id"
    if git merge-base --is-ancestor "$incoming" HEAD 2>/dev/null; then
        continue
    fi
    approved="$common/pr-gate/$incoming.approved.json"
    if [ -f "$approved" ] \
        && grep -q "\"id\": \"$incoming\"" "$approved" \
        && grep -q "\"head\": \"$here\"" "$approved"; then
        continue
    fi
    refuse "$incoming has no approval for HEAD $here"
done < "$merge_head"

[ "$seen" -eq 1 ] || refuse "MERGE_HEAD is empty"
exit 0
